# SignalNest Environment Configuration
# Next.js App
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL / SQLite for development)
# For local dev without Postgres: file:./dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signalnest?schema=public"

# App Security & Encryption Placeholder (For server-side token encryption)
APP_SECRET="signalnest_super_secret_master_encryption_key_32chars"
NEXTAUTH_SECRET="signalnest_nextauth_jwt_secret_token_change_in_prod"

# Official OAuth Credentials (To be populated when official platform APIs are connected)
# GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Meta (Facebook / Instagram)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""

# X (Twitter)
X_API_KEY=""
X_API_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Google / YouTube
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Reddit
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Slack
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""

# Discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""

# Telegram
TELEGRAM_BOT_TOKEN=""

# Optional LLM Provider for real ContentGenerator (Default fallback is realistic mock generator)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
